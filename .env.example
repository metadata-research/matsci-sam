DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MatSci-SAM"
# The authority every published IRI is minted under. Leave unset to mint under
# NEXT_PUBLIC_SITE_URL; the public host sets the registered persistent
# namespace once its redirect is verified.
# IDENTIFIER_BASE_URL="https://w3id.org/matsci-sam"
# The graph store is a projected view of the database. Keep projection off
# until a Fuseki dataset is reachable; graphs:export works either way.
GRAPH_PROJECTION_ENABLED=false
# FUSEKI_DATASET_URL="http://127.0.0.1:3030/matsci-sam"
# HTTP Basic credentials for the Graph Store Protocol writes.
# FUSEKI_USER=""
# FUSEKI_PASSWORD=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""
GOOGLE_AUTH_ACCESS_MODE="existing-or-allowlisted"
GOOGLE_AUTH_ALLOWED_EMAILS=""
# Dormant ORCID OpenID Connect plumbing. Keep false until the client,
# callback, encrypted token storage, branding, and acceptance tests are ready.
ORCID_AUTH_ENABLED=false
ORCID_ENVIRONMENT="sandbox"
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_CALLBACK_URL="http://localhost:3000/api/auth/orcid/callback"
ORCID_SCOPES="openid"
# Generate with: openssl rand -base64 32
AUTH_TOKEN_ENCRYPTION_KEY=""
# Passwordless sign-in and explicit account creation. Keep both false until the
# sender and one-time-link workflow have passed an end-to-end delivery test.
# The application limits each address to one request per minute.
EMAIL_AUTH_ENABLED=false
EMAIL_AUTH_ACCOUNT_CREATION_ENABLED=false
EMAIL_AUTH_PROVIDER="gmail-api"
EMAIL_AUTH_FROM=""
# Preferred pilot provider. Authorize only the gmail.send scope.
EMAIL_AUTH_GMAIL_CLIENT_ID=""
EMAIL_AUTH_GMAIL_CLIENT_SECRET=""
EMAIL_AUTH_GMAIL_REFRESH_TOKEN=""
# Portable fallback for a future institutional relay.
EMAIL_AUTH_SMTP_HOST=""
EMAIL_AUTH_SMTP_PORT=587
EMAIL_AUTH_SMTP_SECURE=false
EMAIL_AUTH_SMTP_USER=""
EMAIL_AUTH_SMTP_PASSWORD=""
EMAIL_AUTH_TOKEN_TTL_MINUTES=15
SESSION_PASSWORD=""
SESSION_COOKIE_SECURE=true
# Temporary local/development login; keep disabled when Google OAuth is active.
DEV_AUTH_ENABLED=false
# DEV_AUTH_USERS=""
# DEV_AUTH_PASSWORD=""
OLLAMA_HOST=""
# Optional: enables the Wolfram AgentOne integration (see /admin/integrations)
# WOLFRAM_API_KEY=""
# Pick a named system prompt from lib/prompts.json (add your own there)...
SYSTEM_PROMPT_KEY="materials-reference"
# ...or set the prompt text directly (takes precedence over SYSTEM_PROMPT_KEY)
# SYSTEM_PROMPT=""
