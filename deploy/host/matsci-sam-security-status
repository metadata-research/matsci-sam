#!/usr/bin/env bash

# Report whether automatic security patching is working on this host.
#
# It answers three questions: is automatic patching enabled and scheduled, is a
# reboot owed, and has the last run errored. Reads only; changes nothing.
#
# Reads that can legitimately find nothing are wrapped individually. Piping into
# a consumer that exits early can kill the writer with SIGPIPE, which pipefail
# promotes to a failed pipeline, which errexit turns into a silent abort.

set -Eeuo pipefail

export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive

attention_reasons=()

fail() {
  echo "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] ||
  fail "Run through sudo: sudo /usr/local/sbin/matsci-sam-security-status"

# Effective value after all of apt.conf.d is merged, so this reports what
# unattended-upgrades will actually do rather than what any one file requests.
apt_value() {
  local value
  value=$(apt-config dump --format '%v%n' "$1" 2>/dev/null || true)
  value=$(head -1 <<<"${value}")
  printf '%s' "${value:-$2}"
}

printf '[policy]\n'
update_lists=$(apt_value APT::Periodic::Update-Package-Lists 0)
run_upgrade=$(apt_value APT::Periodic::Unattended-Upgrade 0)
automatic_reboot=$(apt_value Unattended-Upgrade::Automatic-Reboot false)
printf 'enabled=%s\n' \
  "$([[ ${update_lists} != 0 && ${run_upgrade} != 0 ]] && echo yes || echo no)"
printf 'next_run=%s\n' "$(
  systemctl show -p NextElapseUSecRealtime --value apt-daily-upgrade.timer \
    2>/dev/null || printf 'unknown'
)"
printf 'automatic_reboot=%s at %s\n' \
  "${automatic_reboot}" \
  "$(apt_value Unattended-Upgrade::Automatic-Reboot-Time unset)"

[[ ${update_lists} != 0 && ${run_upgrade} != 0 ]] ||
  attention_reasons+=("automatic security upgrades are disabled")

printf '\n[reboot]\n'
if [[ -f /var/run/reboot-required ]]; then
  printf 'required=yes\n'
  printf 'packages=%s\n' "$(
    if [[ -f /var/run/reboot-required.pkgs ]]; then
      sort -u /var/run/reboot-required.pkgs | paste -sd' ' -
    else
      printf 'unknown'
    fi
  )"
  [[ ${automatic_reboot} == true || ${automatic_reboot} == 1 ]] ||
    attention_reasons+=("a reboot is required and no policy will perform it")
else
  printf 'required=no\n'
fi

# Processes still mapping a pre-upgrade library. needrestart reports SVC when it
# can resolve a systemd unit and PID when it cannot, so both are collected.
printf '\n[stale_processes]\n'
stale=$(
  awk -F': ' '
    $1 == "NEEDRESTART-SVC" { print "service=" $2 }
    $1 == "NEEDRESTART-PID" { print "process=" $2 }
  ' <<<"$(needrestart -b -r l 2>/dev/null || true)"
)
printf '%s\n' "${stale:-none}"

printf '\n[last_run]\n'
last_run=$(
  set +o pipefail
  zcat -f /var/log/apt/history.log /var/log/apt/history.log.*.gz 2>/dev/null |
    grep -A4 '^Commandline: /usr/bin/unattended-upgrade$' |
    awk -F': ' '$1 == "End-Date" { print $2 }' |
    sort |
    tail -1
)
printf 'last_unattended_upgrade=%s\n' "${last_run:-never}"
error_count=$(
  grep -c -h -E '(ERROR|Traceback)' \
    /var/log/unattended-upgrades/unattended-upgrades.log 2>/dev/null || true
)
printf 'log_errors=%s\n' "${error_count:-0}"
if [[ ${error_count:-0} =~ ^[1-9][0-9]*$ ]]; then
  attention_reasons+=("unattended-upgrades has logged errors")
fi

printf '\n[pending]\n'
pending=$(apt list --upgradable 2>/dev/null | grep -F '[upgradable from:' || true)
printf '%s\n' "${pending:-none}"

printf '\n[summary]\n'
if ((${#attention_reasons[@]})); then
  printf 'attention=yes\n'
  printf 'reason=%s\n' "${attention_reasons[@]}"
else
  printf 'attention=no\n'
fi
