# The Fuseki assembler for a local or CI store: one in-memory TDB2 dataset
# with the union default graph, a query endpoint and a Graph Store endpoint,
# all under /matsci-sam. The paper queries in scripts/graph-queries/ name no
# graph and need the union, which a dataset started with --mem does not
# provide. The production assembler is operations material and is kept
# elsewhere; this one holds nothing on disk.
#
#   fuseki-server --config=scripts/fuseki-test-dataset.ttl --port 3030 \
#     --localhost --ping --passwd=<file> --auth=basic

PREFIX :       <#>
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>

[] rdf:type fuseki:Server ;
    fuseki:services ( :matsci_sam ) .

:matsci_sam rdf:type fuseki:Service ;
    fuseki:name "matsci-sam" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp_rw ; fuseki:name "data" ] ;
    fuseki:dataset :matsci_sam_dataset .

:matsci_sam_dataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "--mem--" ;
    tdb2:unionDefaultGraph true .
