# The contributions of a model: for each model with an identity of its own, how many entities are attributed to it and how many activities it was associated with, by kind.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?model ?label ?kind (COUNT(DISTINCT ?contribution) AS ?contributions)
WHERE {
  ?model a prov:SoftwareAgent ;
    rdfs:label ?label .
  # A model with a profile has an IRI of its own; a document-scoped agent
  # node has a fragment and is left out.
  FILTER (!CONTAINS(STR(?model), "#"))
  {
    ?contribution prov:wasAttributedTo ?model ;
      a ?kind .
  }
  UNION
  {
    ?contribution prov:wasAssociatedWith ?model ;
      a ?kind .
  }
  FILTER (?kind NOT IN (prov:Entity, prov:Activity))
}
GROUP BY ?model ?label ?kind
ORDER BY ?model ?kind
