# The vote history of one revision: each voting act on the revision with the most kinds of act, in time order, with the act, its kind, the kind of actor, and the agent where the profile is public.
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX matsci: <https://w3id.org/matsci-sam/metadata#>

SELECT ?revision ?event ?at ?voteKind ?actorKind ?agent
WHERE {
  # The revision with the most distinct kinds of act, then the most acts,
  # ties broken by IRI: a history with a change or a withdrawal where the
  # data holds one, and an answer on any database that holds a vote.
  {
    SELECT ?revision (COUNT(DISTINCT ?kind) AS ?kinds) (COUNT(?act) AS ?acts)
    WHERE {
      ?act a matsci:VoteEvent ;
        prov:used ?revision ;
        matsci:voteKind ?kind .
    }
    GROUP BY ?revision
    ORDER BY DESC(?kinds) DESC(?acts) ?revision
    LIMIT 1
  }
  ?event a matsci:VoteEvent ;
    prov:used ?revision ;
    prov:atTime ?at ;
    matsci:voteKind ?voteKind ;
    matsci:actorKind ?actorKind .
  OPTIONAL { ?event prov:wasAssociatedWith ?agent }
}
ORDER BY ?at ?event
