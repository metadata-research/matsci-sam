# The vote history of one revision: each voting act on the revision with the most acts, in time order, with its kind, the kind of actor, and the agent where the profile is public.
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX matsci: <https://w3id.org/matsci-sam/metadata#>

SELECT ?revision ?at ?voteKind ?actorKind ?agent
WHERE {
  # The revision with the most acts, ties broken by IRI, so the query
  # answers on any database that holds a vote.
  {
    SELECT ?revision (COUNT(?act) AS ?acts)
    WHERE {
      ?act a matsci:VoteEvent ;
        prov:used ?revision .
    }
    GROUP BY ?revision
    ORDER BY DESC(?acts) ?revision
    LIMIT 1
  }
  ?event a matsci:VoteEvent ;
    prov:used ?revision ;
    prov:atTime ?at ;
    matsci:voteKind ?voteKind ;
    matsci:actorKind ?actorKind .
  OPTIONAL { ?event prov:wasAssociatedWith ?agent }
}
ORDER BY ?at ?event
